{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "/",
  "name": "RenderMD",
  "short_name": "RenderMD",
  "description": "Paste, drop or link any markdown and read it beautifully typeset. Private, free, no ads.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "theme_color": "#1c1915",
  "background_color": "#f3f1ec",
  "categories": ["productivity", "utilities", "developer tools"],
  "icons": [
    { "src": "/favicon.svg", "type": "image/svg+xml", "sizes": "any", "purpose": "any" },
    { "src": "/logo192.png", "type": "image/png", "sizes": "192x192", "purpose": "any" },
    { "src": "/logo512.png", "type": "image/png", "sizes": "512x512", "purpose": "any" },
    { "src": "/icon-192-maskable.png", "type": "image/png", "sizes": "192x192", "purpose": "maskable" },
    { "src": "/icon-512-maskable.png", "type": "image/png", "sizes": "512x512", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "text/markdown": [".md", ".markdown", ".mdx", ".mdown", ".mkd"]
      }
    }
  ],
  "launch_handler": { "client_mode": "focus-existing" },
  "shortcuts": [
    { "name": "Blank page", "url": "/?new" },
    { "name": "Markdown cheatsheet", "url": "/cheatsheet" }
  ]
}
