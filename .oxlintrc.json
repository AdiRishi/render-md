{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "import", "jsx-a11y", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "typescript/consistent-type-imports": [
      "error",
      {
        "fixStyle": "inline-type-imports"
      }
    ],
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": [
      "error",
      {
        "checksVoidReturn": {
          "attributes": false
        }
      }
    ],
    "typescript/array-type": [
      "error",
      {
        "default": "array-simple"
      }
    ],
    "import/no-cycle": "error",
    "unicorn/no-array-sort": "off",
    "jsx-a11y/no-autofocus": "off",
    "react-perf/jsx-no-new-function-as-prop": "off",
    "react-perf/jsx-no-new-object-as-prop": "off",
    "react-perf/jsx-no-new-array-as-prop": "off",
    "react-perf/jsx-no-jsx-as-prop": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/consistent-return": "off",
    "unicorn/require-post-message-target-origin": "off",
    "eslint/no-await-in-loop": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "react/no-array-index-key": "off",
    "import/no-named-as-default-member": "off",
    "react/jsx-no-constructed-context-values": "off"
  },
  "ignorePatterns": [".output", ".tanstack", ".wrangler", "public", "**/*.gen.ts"],
  "overrides": [
    {
      "files": ["src/lib/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/routes/**", "**/routes/**"],
                "message": "Routes are the top layer; nothing imports them."
              },
              {
                "group": ["@/features/**"],
                "message": "Shared layers (lib, ui) must not depend on features."
              },
              {
                "group": ["@/ui/**"],
                "message": "lib/ is framework-free helpers; it must not import UI."
              },
              {
                "group": ["react", "react-dom", "react/*"],
                "message": "This layer must stay framework-free."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/ui/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/routes/**", "**/routes/**"],
                "message": "Routes are the top layer; nothing imports them."
              },
              {
                "group": ["@/features/**"],
                "message": "Shared layers (lib, ui) must not depend on features."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/features/markdown/**",
        "src/features/editor/**",
        "src/features/theme/**",
        "src/features/site/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/routes/**", "**/routes/**"],
                "message": "Routes are the top layer; nothing imports them."
              },
              {
                "group": [
                  "@/features/workspace/**",
                  "@/features/cheatsheet/**",
                  "**/features/workspace/**",
                  "**/features/cheatsheet/**"
                ],
                "message": "Foundation features (markdown, editor, theme, site) must not depend on product features (workspace, cheatsheet)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/markdown/engine/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/routes/**", "**/routes/**"],
                "message": "Routes are the top layer; nothing imports them."
              },
              {
                "group": [
                  "@/features/workspace/**",
                  "@/features/cheatsheet/**",
                  "**/features/workspace/**",
                  "**/features/cheatsheet/**"
                ],
                "message": "Foundation features (markdown, editor, theme, site) must not depend on product features (workspace, cheatsheet)."
              },
              {
                "group": ["react", "react-dom", "react/*"],
                "message": "This layer must stay framework-free."
              },
              {
                "group": [
                  "../render/**",
                  "../worker/**",
                  "**/render/**",
                  "**/worker/**",
                  "@/features/**",
                  "@/ui/**"
                ],
                "message": "The markdown engine is pure: it runs in a worker, on the server and in tests. No React, UI or other features."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/workspace/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/routes/**", "**/routes/**"],
                "message": "Routes are the top layer; nothing imports them."
              },
              {
                "group": ["@/features/cheatsheet/**"],
                "message": "Product features are independent of each other."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/cheatsheet/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/routes/**", "**/routes/**"],
                "message": "Routes are the top layer; nothing imports them."
              },
              {
                "group": ["@/features/workspace/**"],
                "message": "Product features are independent of each other."
              }
            ]
          }
        ]
      }
    }
  ]
}
